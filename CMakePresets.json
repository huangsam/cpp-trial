{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base Configuration",
      "description": "Common settings for all configurations.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WITH_SANITIZERS": "OFF",
        "WITH_TSAN": "OFF",
        "WITH_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Development Build (Debug)",
      "description": "Debug build for local development.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WITH_SANITIZERS": "OFF",
        "WITH_TSAN": "OFF",
        "WITH_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI Build (Release)",
      "description": "Release build for CI systems.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_SANITIZERS": "OFF",
        "WITH_TSAN": "OFF",
        "WITH_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build (Optimized)",
      "description": "Optimized release build for final artifacts.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_SANITIZERS": "OFF",
        "WITH_TSAN": "OFF",
        "WITH_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan Build (Debug)",
      "description": "Debug build with ASan and UBSan enabled.",
      "inherits": "dev",
      "cacheVariables": {
        "WITH_SANITIZERS": "ON",
        "WITH_TSAN": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan Build (Debug)",
      "description": "Debug build with ThreadSanitizer enabled.",
      "inherits": "dev",
      "cacheVariables": {
        "WITH_TSAN": "ON",
        "WITH_SANITIZERS": "OFF"
      }
    },
    {
      "name": "tidy",
      "displayName": "Clang-Tidy Build (Debug)",
      "description": "Debug build with Clang-Tidy analysis enabled.",
      "inherits": "dev",
      "cacheVariables": {
        "WITH_CLANG_TIDY": "ON",
        "WITH_SANITIZERS": "OFF",
        "WITH_TSAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "displayName": "Build Development (Debug)",
      "configurePreset": "dev"
    },
    {
      "name": "ci",
      "displayName": "Build CI (Release)",
      "configurePreset": "ci"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "displayName": "Build ASan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "displayName": "Build TSan",
      "configurePreset": "tsan"
    },
    {
      "name": "tidy",
      "displayName": "Build with Clang-Tidy",
      "configurePreset": "tidy"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "displayName": "Test Development (Debug)",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "displayName": "Test CI (Release)",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true,
        "quiet": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Test Release (Optimized)",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "displayName": "Test ASan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "displayName": "Test TSan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
